generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  openId        String    @unique @db.VarChar(64)
  email         String?   @unique @db.VarChar(320)
  passwordHash  String?   @db.VarChar(255)
  name          String?   @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  role          String    @default("user") @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  factories     Factory[]
  webinars      Webinar[]
  subscriptions Subscription[]
  participants  WebinarParticipant[]
  messages      Message[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  company   String?  @db.VarChar(255)
  country   String?  @db.VarChar(100)
  bio       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Factory {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String    @db.VarChar(255)
  slug          String?   @unique @db.VarChar(255)
  logo          String?   @db.VarChar(500)
  category      String?   @db.VarChar(100)
  country       String?   @default("China") @db.VarChar(100)
  city          String?   @db.VarChar(100)
  description   String?   @db.Text
  status        String    @default("pending") @db.VarChar(20)
  overallScore  Decimal?  @default(0) @db.Decimal(3, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  products      Product[]
  participants  WebinarParticipant[]

  @@index([userId])
  @@index([status])
  @@map("factories")
}

model Product {
  id              Int       @id @default(autoincrement())
  factoryId       Int
  name            String    @db.VarChar(255)
  slug            String?   @unique @db.VarChar(255)
  category        String?   @db.VarChar(100)
  description     String?   @db.Text
  images          Json?
  status          String    @default("draft") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  factory         Factory   @relation(fields: [factoryId], references: [id])
  webinarProducts WebinarProduct[]

  @@index([factoryId])
  @@index([status])
  @@map("products")
}

model Webinar {
  id              Int       @id @default(autoincrement())
  hostId          Int
  title           String    @db.VarChar(255)
  slug            String?   @unique @db.VarChar(255)
  description     String?   @db.Text
  coverImage      String?   @db.VarChar(500)
  status          String    @default("draft") @db.VarChar(20)
  scheduledAt     DateTime?
  duration        Int       @default(60)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  host         User      @relation(fields: [hostId], references: [id])
  participants WebinarParticipant[]
  products     WebinarProduct[]
  messages     Message[]

  @@index([hostId])
  @@index([status])
  @@map("webinars")
}

model WebinarParticipant {
  id          Int       @id @default(autoincrement())
  webinarId   Int
  userId      Int?
  factoryId   Int?
  role        String    @default("attendee") @db.VarChar(20)
  status      String    @default("invited") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  webinar Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
  factory Factory? @relation(fields: [factoryId], references: [id])

  @@index([webinarId])
  @@index([userId])
  @@index([factoryId])
  @@map("webinar_participants")
}

model WebinarProduct {
  id        Int      @id @default(autoincrement())
  webinarId Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([webinarId, productId])
  @@index([webinarId])
  @@index([productId])
  @@map("webinar_products")
}

model Message {
  id        Int      @id @default(autoincrement())
  webinarId Int?
  senderId  Int
  content   String   @db.Text
  type      String   @default("text") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id])

  @@index([webinarId])
  @@index([senderId])
  @@map("messages")
}

model Subscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  planId      String   @db.VarChar(50)
  status      String   @default("active") @db.VarChar(20)
  startedAt   DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}
