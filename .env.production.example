# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RealSourcing 生产环境配置文件
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ============================================================================
# 数据库配置 (Database Configuration)
# ============================================================================

DATABASE_URL=mysql://username:password@production-db-host:3306/realsourcing

# ============================================================================
# 应用配置 (Application Configuration)
# ============================================================================

PORT=5000
NODE_ENV=production
APP_URL=https://www.realsourcing.com

# ============================================================================
# 声网配置 (Agora Configuration)
# ============================================================================

AGORA_APP_ID=production_agora_app_id
AGORA_APP_CERTIFICATE=production_agora_app_certificate
AGORA_CUSTOMER_ID=production_agora_customer_id
AGORA_CUSTOMER_SECRET=production_agora_customer_secret

# ============================================================================
# 阿里云 OSS 配置 (Aliyun OSS Configuration)
# ============================================================================

OSS_ACCESS_KEY_ID=production_oss_access_key_id
OSS_ACCESS_KEY_SECRET=production_oss_access_key_secret
OSS_BUCKET=realsourcing-production
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com

# ============================================================================
# Nova AI 配置 (Nova AI Configuration)
# ============================================================================

NOVA_API_KEY=production_nova_api_key
NOVA_API_BASE_URL=https://api.nova-ai.com

# ============================================================================
# 支付配置 (Payment Configuration)
# ============================================================================

ALIPAY_APP_ID=production_alipay_app_id
ALIPAY_PRIVATE_KEY=production_alipay_private_key
ALIPAY_PUBLIC_KEY=production_alipay_public_key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

WECHAT_MERCHANT_ID=production_wechat_merchant_id
WECHAT_API_KEY=production_wechat_api_key
WECHAT_APP_ID=production_wechat_app_id
WECHAT_APP_SECRET=production_wechat_app_secret

# ============================================================================
# 邮件配置 (Email Configuration)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@realsourcing.com
SMTP_PASSWORD=production_smtp_password
SMTP_FROM=noreply@realsourcing.com

# ============================================================================
# Redis 配置 (Redis Configuration)
# ============================================================================

REDIS_URL=redis://production-redis-host:6379

# ============================================================================
# 日志配置 (Logging Configuration)
# ============================================================================

LOG_LEVEL=warn
LOG_FILE=/var/log/realsourcing/app.log

# ============================================================================
# 安全配置 (Security Configuration)
# ============================================================================

JWT_SECRET=production_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d
SESSION_SECRET=production_session_secret_key_change_this

# ============================================================================
# 其他配置 (Other Configuration)
# ============================================================================

DEBUG=false
CORS_ENABLED=true
CORS_ORIGIN=https://www.realsourcing.com
MAX_FILE_SIZE=50

# ============================================================================
# 监控配置 (Monitoring Configuration)
# ============================================================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GA_TRACKING_ID=UA-XXXXXXXXX-X
