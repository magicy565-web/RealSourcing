# Database (必需)
DATABASE_URL=mysql://user:password@localhost:3306/realsourcing

# 认证配置 (必需)
# JWT Secret，必须至少 32 个字符
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Session Secret
SESSION_SECRET=your-session-secret-key

# Agora (Video Conferencing & Real-time Messaging)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
VITE_AGORA_APP_ID=your-agora-app-id

# Agora Cloud Recording & Real-time Transcription
AGORA_CUSTOMER_ID=your-agora-customer-id
AGORA_CUSTOMER_SECRET=your-agora-customer-secret

# Agora Interactive Whiteboard
WHITEBOARD_AK=your-whiteboard-access-key
WHITEBOARD_SK=your-whiteboard-secret-key
VITE_WHITEBOARD_APP_ID=your-whiteboard-app-id

# OpenAI / Third-party AI (Report Generation)
# Default: Third-party AI service
OPENAI_API_KEY=sk-LIs2MGKmDuGZhcfHbvLs1EiWHPwm2ELf3E8JkJXlFXgFLPBM
OPENAI_BASE_URL=https://once.novai.su/v1
OPENAI_MODEL=[逆次]o4-mini

# For official OpenAI API, use:
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo-preview

# Payment (Alipay & WeChat Pay)
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
WECHAT_MCH_ID=your-wechat-mch-id
WECHAT_API_KEY=your-wechat-api-key
WECHAT_SERIAL_NO=your-wechat-serial-no
WECHAT_PRIVATE_KEY=your-wechat-private-key
WECHAT_PUBLIC_KEY=your-wechat-public-key

# Aliyun OSS (for storing recordings and transcriptions)
OSS_BUCKET=your-oss-bucket-name
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret

# Application
APP_URL=http://localhost:5000
NODE_ENV=development
PORT=3000

# 日志级别 (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# 前端配置
# API 地址
VITE_API_URL=http://localhost:3000/api/trpc

# Directus CMS 地址
VITE_DIRECTUS_URL=https://admin.cnsubscribe.xyz

# 应用版本
VITE_APP_VERSION=1.0.0
